# Copy to `.env` before building: `cp .env.example .env`, then fill in the
# values. `.env` is git-ignored and is a declared Flutter asset (pubspec.yaml),
# so the file must exist for the build to succeed even if the values are blank.

# LLM router — used by the speech summarizer and the intent / conversation
# services under lib/core/services/ai_services/.
API_URL=
MODEL_NAME=gemini-2.5-flash
API_KEY=

# TravelBuddy chat backend. TRAVELBUDDY_API_URL is a Cloudflare tunnel and
# changes whenever the tunnel restarts, which is why it belongs here rather than
# hardcoded in flight_services.dart.
# TRAVELBUDDY_API_KEY is sent as `x-api-key` on every request except /health.
# TRAVELBUDDY_MEMBER_NO is sent as `x-member-no`.
TRAVELBUDDY_API_URL=
TRAVELBUDDY_API_KEY=
TRAVELBUDDY_MEMBER_NO=

# Cartesia neural TTS — spoken replies in audio mode. Get a key at
# https://play.cartesia.ai/keys
# Without this, VoiceService falls back to the on-device flutter_tts engine.
CARTESIA_API_KEY=
# Optional overrides. Defaults are the Katie voice on sonic-3.5.
# CARTESIA_VOICE_ID=
# CARTESIA_MODEL_ID=sonic-3.5
